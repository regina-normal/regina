# Single-variable:
p = ExampleLink.trefoil().jones()
print(p)
print(p.str())
print(p.str('a'))
print(p.utf8())
print(p.utf8('\u03B1'))
print(p.polynomial())
print(p[-10])
print(p[8])
p.set(7, 3)
p[-5] = -3
p[8] = 0
print(p)
print(p.minExp(), p.maxExp())

for c in ExampleLink.trefoil().jones():
    print(c)

c = ExampleLink.trefoil().jones().first()
while c:
    print((c.exp(0), c.coeff()), c.exponents(), c.inc())

c = ExampleLink.trefoil().jones().last()
while c:
    print((c.exp(0), c.coeff()), c.exponents(), c.dec())

print()

# Two-variable:
q = ExampleLink.trefoil().homfly()
print(q)
print(q.str())
print(q.str('a', 'b'))
print(q.utf8())
print(q.utf8('\u03B1', 'z'))
print(q[5,7])
print(q[-2,0])
print(q[-2,2])
q.set(1, -1, 3)
q[3,4] = 5
q[-4,0] = 0
print(q)

for c in ExampleLink.trefoil().homfly():
    print(c)

c = ExampleLink.trefoil().homfly().first()
while c:
    print((c.exp(0), c.exp(1), c.coeff()), c.exponents(), c.inc())

c = ExampleLink.trefoil().homfly().last()
while c:
    print((c.exp(0), c.exp(1), c.coeff()), c.exponents(), c.dec())

print()

# Three-variable:
p = ExampleLink.trefoil().jones()
q = ExampleLink.trefoil().homfly()
r = Laurent3(p, q)
print(r)
print(r.str())
print(r.str('a', 'b', 'c'))
print(r.utf8())
print(r.utf8('\u03B1', 'z', 'q'))
print(r[6,5,7])
print(r[6,-2,0])
print(r[2,-2,2])
r.set(1, -1, 7, 3)
r[2,-2,4] = 5
r[6,-2,2] = 0
print(r)

for c in Laurent3(p, q):
    print(c)

c = Laurent3(p, q).first()
while c:
    print((c.exp(0), c.exp(1), c.exp(2), c.coeff()), c.exponents(), c.inc())

c = Laurent3(p, q).last()
while c:
    print((c.exp(0), c.exp(1), c.exp(2), c.coeff()), c.exponents(), c.dec())

# Test tuple vs list options for construction:
print(Laurent2([([3,1], 4), ([0,-1], -2), ([-6,0], -1)]))
print(Laurent2([((3,1), 4), ((0,-1), -2), ((-6,0), -1)]))
print(Laurent2([[[3,1], 4], [[0,-1], -2], [[-6,0], -1]]))
print(Laurent2((((3,1), 4), ((0,-1), -2), ((-6,0), -1))))

# Test exceptions for invalid terms when constructing:
try:
    Laurent2([([3,1], 4), ([0,-1,4], -2), ([-6,0], -1)])
except Exception as e:
    print('Caught exception:', type(e))

try:
    Laurent2([([3,1], 4), ([0,-1], -2), ([-6,0], -1), ([3,1], 7)])
except Exception as e:
    print('Caught exception:', type(e))

